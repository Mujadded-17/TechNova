@model TechNova.Models.InvestorDashboardViewModel

@{
	ViewData["Title"] = "Investor Dashboard";
	Layout = "_Layout";

	var firstName = Model.Investor.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "there";
}

<div class="row mb-4 align-items-center">
	<div class="col-md-8">
		<h1 class="mb-1">Welcome back, @firstName</h1>
		<p class="text-muted mb-0">
			@if (Model.HasAccess)
			{
				<text>Your subscription is active — browse, message founders and send investment requests.</text>
			}
			else
			{
				<text>Start a free trial to message founders and send investment requests.</text>
			}
		</p>
	</div>
	<div class="col-md-4 text-md-end mt-3 mt-md-0">
		@if (!Model.HasAccess)
		{
			<a href="@Url.Action("Plans", "Billing")" class="btn btn-primary me-2">Start free trial</a>
		}
		<a href="@Url.Action("EditProfile", "Investor")" class="btn btn-outline-primary">Edit profile</a>
	</div>
</div>

<!-- Quick stats -->
<div class="row g-3 mb-4">
	<div class="col-6 col-lg-3">
		<a class="card stat-card h-100 text-decoration-none" href="@Url.Action("MyRequests", "Investor")">
			<div class="card-body">
				<div class="stat-card__label">Active requests</div>
				<div class="stat-card__value">@Model.ActiveRequestCount</div>
				<div class="stat-card__hint">@Model.RequestCount total</div>
			</div>
		</a>
	</div>
	<div class="col-6 col-lg-3">
		<a class="card stat-card h-100 text-decoration-none" href="@Url.Action("Favorites", "Investor")">
			<div class="card-body">
				<div class="stat-card__label">Saved startups</div>
				<div class="stat-card__value">@Model.FavoriteCount</div>
				<div class="stat-card__hint">View your list</div>
			</div>
		</a>
	</div>
	<div class="col-6 col-lg-3">
		<a class="card stat-card h-100 text-decoration-none" href="@Url.Action("Index", "Message")">
			<div class="card-body">
				<div class="stat-card__label">Unread messages</div>
				<div class="stat-card__value">@Model.UnreadMessages</div>
				<div class="stat-card__hint">Open inbox</div>
			</div>
		</a>
	</div>
	<div class="col-6 col-lg-3">
		<a class="card stat-card h-100 text-decoration-none" href="@Url.Action("Manage", "Billing")">
			<div class="card-body">
				<div class="stat-card__label">Plan</div>
				<div class="stat-card__value">@(Model.HasAccess ? "Active" : "None")</div>
				<div class="stat-card__hint">Manage subscription</div>
			</div>
		</a>
	</div>
</div>

<!-- Recent startups -->
<div class="d-flex justify-content-between align-items-center mb-3">
	<h3 class="mb-0">Recently updated startups</h3>
	<a href="@Url.Action("Startups", "Explore")" class="btn btn-sm btn-outline-primary">Browse all</a>
</div>

@if (Model.RecentStartups.Count == 0)
{
	<div class="card mb-4">
		<div class="card-body text-center text-muted py-5">
			No startups have published a profile yet. Check back soon.
		</div>
	</div>
}
else
{
	<div class="row g-3 mb-4">
		@foreach (var s in Model.RecentStartups)
		{
			var initials = string.Concat(s.CompanyName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0])).ToUpperInvariant();
			<div class="col-md-6 col-lg-4">
				<a class="card h-100 dir-card text-decoration-none" href="@Url.Action("Startup", "Explore", new { id = s.StartupID })">
					<div class="card-body">
						<div class="d-flex align-items-center gap-3 mb-2">
							<span class="dir-avatar">@initials</span>
							<div class="min-w-0">
								<strong class="d-block text-truncate">@s.CompanyName</strong>
								<span class="text-muted small">
									@(string.IsNullOrWhiteSpace(s.Industry) ? "Startup" : s.Industry)
									@if (!string.IsNullOrWhiteSpace(s.Location)) { <text>&middot; @s.Location</text> }
								</span>
							</div>
						</div>
						@if (!string.IsNullOrWhiteSpace(s.Tagline))
						{
							<p class="small text-muted mb-2">@s.Tagline</p>
						}
						<div class="d-flex justify-content-between small">
							<span class="text-muted">Seeking</span>
							<strong>$@s.FundingRequired.ToString("N0")</strong>
						</div>
					</div>
				</a>
			</div>
		}
	</div>
}

<!-- Recent requests -->
<div class="d-flex justify-content-between align-items-center mb-3">
	<h3 class="mb-0">Your recent requests</h3>
	@if (Model.MyRequests.Count > 0)
	{
		<a href="@Url.Action("MyRequests", "Investor")" class="btn btn-sm btn-outline-primary">View all</a>
	}
</div>

@if (Model.MyRequests.Count == 0)
{
	<div class="card">
		<div class="card-body text-center text-muted py-5">
			You haven't sent any investment requests yet.
			<a href="@Url.Action("Startups", "Explore")">Find a startup</a> and click <strong>Request to invest</strong> on its profile.
		</div>
	</div>
}
else
{
	<div class="card">
		<div class="table-responsive">
			<table class="table table-hover mb-0 align-middle">
				<thead>
					<tr>
						<th>Startup</th>
						<th>Amount</th>
						<th>Status</th>
						<th>Sent</th>
						<th class="text-end">Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var r in Model.MyRequests)
					{
						var tone = r.Status switch { "Accepted" => "bg-success", "Rejected" => "bg-danger", _ => "bg-secondary" };
						<tr>
							<td>@r.Startup.CompanyName</td>
							<td>$@r.InvestmentAmount.ToString("N0")</td>
							<td><span class="badge @tone">@r.Status</span></td>
							<td class="text-muted">@r.RequestDate.ToLocalTime().ToString("dd MMM yyyy")</td>
							<td class="text-end">
								<a href="@Url.Action("Startup", "Explore", new { id = r.StartupID })" class="btn btn-sm btn-outline-primary">View</a>
								<a href="@Url.Action("Thread", "Message", new { id = r.StartupID })" class="btn btn-sm btn-primary">Message</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</div>
}
