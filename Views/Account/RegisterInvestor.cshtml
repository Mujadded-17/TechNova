@model TechNova.Models.RegisterInvestor

@{
    ViewData["Title"] = "Register Investor";
}

<link rel="stylesheet" href="~/css/account.css" />

<div class="login-page">

    <div class="login-card register-card">

        <div class="login-header">
            <h1>TechNova</h1>
            <p>Discover promising startups and investment opportunities</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="login-error">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="RegisterInvestor"
              method="post">

            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Name"></label>

                <input asp-for="Name"
                       placeholder="Enter your full name" />

                <span asp-validation-for="Name"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="CompanyName"></label>

                <input asp-for="CompanyName"
                       placeholder="Company or organization name" />
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>

                <input asp-for="Email"
                       type="email"
                       placeholder="Enter your email" />

                <span asp-validation-for="Email"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Phone"></label>

                <input asp-for="Phone"
                       type="tel"
                       placeholder="Enter your phone number" />

                <span asp-validation-for="Phone"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>

                <input asp-for="Password"
                       type="password"
                       placeholder="Create a password" />

                <span asp-validation-for="Password"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       placeholder="Confirm your password" />

                <span asp-validation-for="ConfirmPassword"
                      class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Preference"></label>

                <input asp-for="Preference"
                       placeholder="Example: AI, FinTech, HealthTech" />
            </div>

            <div class="form-group">
                <label asp-for="InvestmentRange"></label>

                <input asp-for="InvestmentRange"
                       type="number"
                       step="0.01"
                       placeholder="Example: 1000000" />

                <span asp-validation-for="InvestmentRange"
                      class="validation-error"></span>
            </div>

            <button type="submit" class="login-button">
                Register as Investor
            </button>

        </form>

        <div class="register-section">

            <p>Already have an account?</p>

            <div class="register-buttons">

                <a asp-controller="Account"
                   asp-action="Login"
                   class="register-button investor-button">
                    Login
                </a>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
