@model TechNova.Models.RegisterInvestor

@{
    ViewData["Title"] = "Sign Up — Investor";
    ViewData["AuthMode"] = "signup";
    ViewData["AuthRole"] = "investor";
    ViewData["AsideTitle"] = "Discover the next opportunity.";
    ViewData["AsideCopy"] = "Set your preferences once, then explore startups that match your industry, stage and cheque size.";
    Layout = "_AuthLayout";
}

<partial name="_AuthSwitch" />

<div class="auth__head">
    <h1>Create your investor profile</h1>
    <p>Tell us what you invest in and we'll surface the right startups.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="auth-alert" role="alert">
        <svg class="ico ico--sm"><use href="#i-alert" /></svg>
        <span>@ViewBag.Error</span>
    </div>
}

<form asp-controller="Account"
      asp-action="RegisterInvestor"
      method="post"
      class="auth-form">

    @Html.AntiForgeryToken()

    <div class="field">
        <label asp-for="Name"></label>
        <input asp-for="Name" autocomplete="name" placeholder="Enter your full name" />
        <span asp-validation-for="Name" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="CompanyName"></label>
        <input asp-for="CompanyName" placeholder="Company or organization name" />
        <span asp-validation-for="CompanyName" class="field-error"></span>
    </div>

    <div class="field-row">

        <div class="field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="Phone"></label>
            <input asp-for="Phone" type="tel" autocomplete="tel" placeholder="Phone number" />
            <span asp-validation-for="Phone" class="field-error"></span>
        </div>

    </div>

    <div class="field-row">

        <div class="field field--password">
            <label asp-for="Password"></label>
            <input asp-for="Password" type="password" autocomplete="new-password" placeholder="Create a password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field field--password">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Confirm password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

    </div>

    <div class="field">
        <label asp-for="Preference"></label>
        <input asp-for="Preference" placeholder="Example: AI, FinTech, HealthTech" />
        <span asp-validation-for="Preference" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="InvestmentRange"></label>
        <input asp-for="InvestmentRange" type="number" step="0.01" placeholder="1000000" />
        <span asp-validation-for="InvestmentRange" class="field-error"></span>
    </div>

    <button type="submit" class="btn btn--brand auth-submit">
        Create Investor Account
        <svg class="ico ico--sm btn__arrow"><use href="#i-arrow-right" /></svg>
    </button>

</form>

<p class="auth__foot">
    Already have an account?
    <a asp-controller="Account" asp-action="Login">Sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
