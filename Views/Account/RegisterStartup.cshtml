@model TechNova.Models.RegisterStartup

@{
    ViewData["Title"] = "Sign Up — Startup";
    ViewData["AuthMode"] = "signup";
    ViewData["AuthRole"] = "startup";
    ViewData["AsideTitle"] = "Turn your idea into an opportunity.";
    ViewData["AsideCopy"] = "Showcase your business, define what you're raising, and reach investors who are actively looking.";
    Layout = "_AuthLayout";
}

<partial name="_AuthSwitch" />

<div class="auth__head">
    <h1>Create your startup profile</h1>
    <p>Tell investors what you're building and what you need.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="auth-alert" role="alert">
        <svg class="ico ico--sm"><use href="#i-alert" /></svg>
        <span>@ViewBag.Error</span>
    </div>
}

<form asp-controller="Account"
      asp-action="RegisterStartup"
      method="post"
      class="auth-form">

    @Html.AntiForgeryToken()

    <div class="field">
        <label asp-for="CompanyName">
            Company Name <span class="required">*</span>
        </label>
        <input asp-for="CompanyName" placeholder="Enter your startup name" />
        <span asp-validation-for="CompanyName" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Email">
            Email <span class="required">*</span>
        </label>

        <input asp-for="Email" type="email" autocomplete="email" placeholder="Enter your business email" />
        <span asp-validation-for="Email" class="field-error"></span>
    </div>

    <div class="field-row">

        <div class="field field--password">
            <label asp-for="Password">
                Password <span class="required">*</span>
            </label>
            <input asp-for="Password" type="password" autocomplete="new-password" placeholder="Create a password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>

        <div class="field field--password">
            <label asp-for="ConfirmPassword">
                Confirm Password <span class="required">*</span>
            </label>
            <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Confirm password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>

    </div>

    <div class="field">
        <label asp-for="Description">
            Description <span class="required">*</span>
        </label>
        <textarea asp-for="Description" rows="4" placeholder="What problem does your startup solve?"></textarea>
        <span asp-validation-for="Description" class="field-error"></span>
    </div>

    <div class="field">
        <label asp-for="Website"></label>
        <input asp-for="Website" placeholder="https://yourstartup.com" />
        <span asp-validation-for="Website" class="field-error"></span>
    </div>

    <div class="field-row">

        <div class="field">
            <label asp-for="FundingRequired">
                Funding Required <span class="required">*</span>
            </label>
            <input asp-for="FundingRequired" type="number" step="0.01" placeholder="500000" />
            <span asp-validation-for="FundingRequired" class="field-error"></span>
        </div>

        <div class="field">
            <label asp-for="BusinessStage">
                Business Stage <span class="required">*</span>
            </label>
            <select asp-for="BusinessStage">
                <option value="">Select stage</option>
                <option value="Idea">Idea Stage</option>
                <option value="Prototype">Prototype</option>
                <option value="MVP">MVP</option>
                <option value="Early Stage">Early Stage</option>
                <option value="Growth">Growth Stage</option>
                <option value="Established">Established</option>
            </select>

            <span asp-validation-for="BusinessStage" class="field-error"></span>
        </div>

    </div>

    <button type="submit" class="btn btn--brand auth-submit">
        Create Startup Account
        <svg class="ico ico--sm btn__arrow"><use href="#i-arrow-right" /></svg>
    </button>

</form>

<p class="auth__foot">
    Already have an account?
    <a asp-controller="Account" asp-action="Login">Sign in</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
