@{
    ViewData["Title"] = "Sign In";
    ViewData["AuthMode"] = "signin";
    ViewData["AsideTitle"] = "Great ideas deserve the right investors.";
    Layout = "_AuthLayout";
}

<partial name="_AuthSwitch" />

<div class="auth__head">
    <h1>Welcome back</h1>
    <p>Sign in to pick up where you left off.</p>
</div>

@if (ViewBag.Error != null)
{
    <div class="auth-alert" role="alert">
        <svg class="ico ico--sm"><use href="#i-alert" /></svg>
        <span>
            @ViewBag.Error
            @if (ViewBag.Unverified != null)
            {
                <a asp-action="ResendVerification" asp-route-email="@ViewBag.Unverified">
                    Send a new link
                </a>
            }
        </span>
    </div>
}

<form asp-controller="Account"
      asp-action="Login"
      method="post"
      class="auth-form">

    @Html.AntiForgeryToken()

    <div class="field">
        <label for="email">Email</label>

        <input type="email"
               id="email"
               name="email"
               autocomplete="email"
               placeholder="Enter your email"
               required />
    </div>

    <div class="field field--password">
        <label for="password">Password</label>

        <input type="password"
               id="password"
               name="password"
               autocomplete="current-password"
               placeholder="Enter your password"
               required />
    </div>

    <button type="submit" class="btn btn--brand auth-submit">
        Sign In
        <svg class="ico ico--sm btn__arrow"><use href="#i-arrow-right" /></svg>
    </button>

</form>

<p class="auth__foot">
    Don't have an account?
    <a asp-controller="Account" asp-action="RegisterStartup">Create one</a>
</p>
