@model List<TechNova.Models.InvestmentRequest>

@{
	ViewData["Title"] = "Investment Requests";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">
	<div class="row mb-4">
		<div class="col-12">
			<h1 class="mb-2">Investment Requests</h1>
			<p class="text-muted">Manage investment inquiries from investors</p>
		</div>
	</div>

	@if (TempData["Success"] != null)
	{
		<div class="alert alert-success alert-dismissible fade show" role="alert">
			@TempData["Success"]
			<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
		</div>
	}

	@if (Model.Count == 0)
	{
		<div class="alert alert-info" role="alert">
			<h4 class="alert-heading">No Requests Yet</h4>
			<p>You haven't received any investment requests yet. Once investors express interest in your startup, their requests will appear here.</p>
		</div>
	}
	else
	{
		<div class="table-responsive">
			<table class="table table-hover">
				<thead class="table-light">
					<tr>
						<th>Investor</th>
						<th>Amount</th>
						<th>Date</th>
						<th>Status</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var request in Model)
					{
						<tr>
							<td>
								<strong>@request.Investor?.Name</strong><br>
								<small class="text-muted">@request.Investor?.InvestorType</small>
							</td>
							<td>
								<strong>${@request.InvestmentAmount:N0}</strong>
							</td>
							<td>
								@request.RequestDate.ToString("MMM dd, yyyy")
							</td>
                            <td>
                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (request.Status == "Accepted")
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @request.Status
                                    </span>
                                }
                            </td>

                            <td>

                                @if (request.Status == "Pending")
                                {
                                    <div class="d-flex gap-1">

                                        <form method="post"
                                              asp-action="UpdateRequestStatus"
                                              asp-controller="Startup">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="requestId"
                                                   value="@request.RequestID" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="Accepted" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                Accept
                                            </button>

                                        </form>

                                        <form method="post"
                                              asp-action="UpdateRequestStatus"
                                              asp-controller="Startup">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="requestId"
                                                   value="@request.RequestID" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="Rejected" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Reject
                                            </button>

                                        </form>

                                    </div>
                                }

                                <a href="@Url.Action("Thread", "Message",
                                                   new { id = request.InvestorID })"
                                   class="btn btn-sm btn-outline-primary mt-1">
                                    Open Conversation
                                </a>

                               

                            </td>
							<td>
								<a href="@Url.Action("Profile", "Investor", new { id = request.InvestorID })" class="btn btn-sm btn-primary">View Profile</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	}
</div>
