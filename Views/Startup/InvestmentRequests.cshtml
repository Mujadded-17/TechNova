@model List<TechNova.Models.InvestmentRequest>

@{
    ViewData["Title"] = "Investment Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">

    <div class="row mb-4">
        <div class="col-12">
            <h1 class="mb-2">Investment Requests</h1>
            <p class="text-muted">
                Manage investment inquiries from investors
            </p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">No Requests Yet</h4>

            <p>
                You haven't received any investment requests yet.
                Once investors express interest in your startup,
                their requests will appear here.
            </p>
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-light">
                    <tr>
                        <th>Investor</th>
                        <th>Amount</th>
                        <th>Date</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var request in Model)
                    {
                        <tr>

                            <!-- Investor -->
                            <td>
                                <strong>
                                    @request.Investor?.Name
                                </strong>

                                <br>

                                <small class="text-muted">
                                    @request.Investor?.InvestorType
                                </small>
                            </td>

                            <!-- Amount -->
                            <td>
                                <strong>
                                    ৳@request.InvestmentAmount.ToString("N0")
                                </strong>
                            </td>

                            <!-- Date -->
                            <td>
                                @request.RequestDate.ToString("MMM dd, yyyy")
                            </td>

                            <!-- Status -->
                            <td>

                                @if (request.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (request.Status == "Accepted")
                                {
                                    <span class="badge bg-success">
                                        Accepted
                                    </span>
                                }
                                else if (request.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @request.Status
                                    </span>
                                }

                            </td>

                            <!-- Actions -->
                            <td>

                                <div class="d-flex flex-wrap gap-1 align-items-center">

                                    @if (request.Status == "Pending")
                                    {
                                        <!-- Accept -->
                                        <form method="post"
                                              asp-action="UpdateRequestStatus"
                                              asp-controller="Startup"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="requestId"
                                                   value="@request.RequestID" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="Accepted" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-success">
                                                Accept
                                            </button>

                                        </form>

                                        <!-- Reject -->
                                        <form method="post"
                                              asp-action="UpdateRequestStatus"
                                              asp-controller="Startup"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="requestId"
                                                   value="@request.RequestID" />

                                            <input type="hidden"
                                                   name="status"
                                                   value="Rejected" />

                                            <button type="submit"
                                                    class="btn btn-sm btn-danger">
                                                Reject
                                            </button>

                                        </form>
                                    }

                                    <!-- Open Conversation -->
                                    <a asp-controller="Message"
                                       asp-action="Thread"
                                       asp-route-id="@request.InvestorID"
                                       class="btn btn-sm btn-outline-primary">

                                        Open Conversation

                                    </a>

                                    <!-- View Profile -->
                                    <a asp-controller="Investor"
                                       asp-action="Profile"
                                       asp-route-id="@request.InvestorID"
                                       class="btn btn-sm btn-primary">

                                        View Profile

                                    </a>

                                    <!-- PDF -->
                                    @if (request.Status == "Accepted")
                                    {
                                        @if (!request.StartupPdfDownloaded)
                                        {
                                            <a asp-controller="Message"
                                               asp-action="DownloadInvestmentConfirmation"
                                               asp-route-requestId="@request.RequestID"
                                               target="_blank"
                                               class="btn btn-sm btn-success">

                                                📄 Download PDF

                                            </a>
                                        }
                                        else
                                        {
                                            <a asp-controller="Message"
                                               asp-action="DownloadInvestmentConfirmation"
                                               asp-route-requestId="@request.RequestID"
                                               target="_blank"
                                               class="btn btn-sm btn-outline-success"
                                               title="View Investment Confirmation PDF">

                                                📄

                                            </a>
                                        }
                                    }

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

</div>
```
