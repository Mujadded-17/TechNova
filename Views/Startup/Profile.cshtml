@model TechNova.Models.Startup

@{
	ViewData["Title"] = $"{Model.CompanyName} - Startup Profile";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<link rel="stylesheet" href="~/css/facebook-style.css" />

<!-- Hero Section with Cover Image -->
<div class="startup-hero">
	@if (!string.IsNullOrEmpty(Model.CoverImagePath))
	{
		<img src="@Model.CoverImagePath" alt="@Model.CompanyName Cover" class="startup-cover-image" />
	}
	else
	{
		<div class="startup-cover-image"></div>
	}
</div>

<!-- Header and Profile Info -->
<div class="startup-header-container">
	<div class="startup-profile-meta">
		@if (!string.IsNullOrEmpty(Model.LogoPath))
		{
			<div class="startup-logo-wrapper">
				<img src="@Model.LogoPath" alt="@Model.CompanyName Logo" class="startup-logo" />
			</div>
		}
		else
		{
			<div class="startup-logo-wrapper">
				<div class="startup-logo"></div>
			</div>
		}

		<div class="startup-info-section">
			<div class="startup-name-and-tagline">
				<h1>@Model.CompanyName</h1>
				@if (!string.IsNullOrEmpty(Model.Tagline))
				{
					<p class="startup-tagline">@Model.Tagline</p>
				}
			</div>
			<div class="startup-quick-actions">
				<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#contactModal">
					Get In Touch
				</button>
			</div>
		</div>
	</div>
</div>

<!-- Main Content Area: Feed + Sidebar -->
<div class="startup-feed-container">
	<!-- Feed Column -->
	<div class="startup-feed-column">
		<!-- About Section -->
		@if (!string.IsNullOrEmpty(Model.Description))
		{
			<div class="feed-create-post">
				<h3 style="margin-top: 0; font-size: 1.1rem; color: var(--ink); font-weight: 600; margin-bottom: 1rem;">About</h3>
				<p style="color: var(--ink); line-height: 1.6; margin: 0;">@Model.Description</p>
			</div>
		}

		<!-- Posts Feed -->
		<div id="postsFeed" class="startup-feed">
			<div class="empty-state">
				<div class="empty-state-icon">📝</div>
				<div class="empty-state-title">No posts yet</div>
				<div class="empty-state-text">This startup hasn't shared any updates</div>
			</div>
		</div>

		<!-- Photo Gallery Section -->
		<div class="photo-gallery" id="photoGallerySection" style="display: none;">
			<div class="gallery-header">
				<h3>Gallery</h3>
			</div>
			<div id="photoGallery" class="gallery-grid">
				<!-- Photos will be dynamically loaded here -->
			</div>
		</div>
	</div>

	<!-- Sidebar Column -->
	<div class="startup-sidebar">
		<!-- Key Metrics Widget -->
		@if (Model.FundingRequired > 0)
		{
			<div class="sidebar-widget">
				<h4 class="widget-title">Funding</h4>
				<div class="startup-stats">
					<div class="stat-item">
						<span class="stat-label">Funding Goal</span>
						<span class="stat-value">${@Model.FundingRequired:N0}</span>
					</div>
					<div class="stat-item">
						<span class="stat-label">Amount Raised</span>
						<span class="stat-value text-success">${@Model.AmountRaised:N0}</span>
					</div>
					<div class="stat-item">
						<span class="stat-label">Progress</span>
						<span class="stat-value">
							@{
								var progress = Model.FundingRequired > 0 ? (int)((Model.AmountRaised / Model.FundingRequired) * 100) : 0;
							}
							@progress%
						</span>
					</div>
				</div>
				<div style="margin-top: 1rem;">
					<div class="progress" style="height: 8px;">
						@{
							var progressPercent = Model.FundingRequired > 0 ? (int)((Model.AmountRaised / Model.FundingRequired) * 100) : 0;
						}
						<div class="progress-bar bg-success" style="width: @progressPercent%"></div>
					</div>
				</div>
			</div>
		}

		<!-- Company Info Widget -->
		<div class="sidebar-widget">
			<h4 class="widget-title">Information</h4>
			<div class="startup-info-widget">
				@if (!string.IsNullOrEmpty(Model.Industry))
				{
					<div class="info-row">
						<span class="info-label">Industry</span>
						<span class="info-value">@Model.Industry</span>
					</div>
				}
				@if (!string.IsNullOrEmpty(Model.Location))
				{
					<div class="info-row">
						<span class="info-label">Location</span>
						<span class="info-value">@Model.Location</span>
					</div>
				}
				@if (Model.FoundedYear.HasValue)
				{
					<div class="info-row">
						<span class="info-label">Founded</span>
						<span class="info-value">@Model.FoundedYear</span>
					</div>
				}
				@if (Model.NumberOfEmployees.HasValue)
				{
					<div class="info-row">
						<span class="info-label">Team Size</span>
						<span class="info-value">@Model.NumberOfEmployees+ employees</span>
					</div>
				}
				@if (!string.IsNullOrEmpty(Model.Website))
				{
					<div class="info-row">
						<span class="info-label">Website</span>
						<span class="info-value"><a href="@Model.Website" target="_blank" style="color: var(--brand);">Visit →</a></span>
					</div>
				}
			</div>
		</div>

		<!-- Business Model Widget -->
		@if (!string.IsNullOrEmpty(Model.BusinessStage) || !string.IsNullOrEmpty(Model.BusinessModel))
		{
			<div class="sidebar-widget">
				<h4 class="widget-title">Business</h4>
				<div class="startup-info-widget">
					@if (!string.IsNullOrEmpty(Model.BusinessStage))
					{
						<div class="info-row">
							<span class="info-label">Stage</span>
							<span class="info-value">@Model.BusinessStage</span>
						</div>
					}
					@if (!string.IsNullOrEmpty(Model.BusinessModel))
					{
						<div class="info-row">
							<span class="info-label">Model</span>
							<span class="info-value">@Model.BusinessModel</span>
						</div>
					}
					@if (Model.EquityOffered.HasValue)
					{
						<div class="info-row">
							<span class="info-label">Equity Offered</span>
							<span class="info-value">@Model.EquityOffered%</span>
						</div>
					}
					@if (Model.MinimumInvestment.HasValue)
					{
						<div class="info-row">
							<span class="info-label">Min Investment</span>
							<span class="info-value">${@Model.MinimumInvestment:N0}</span>
						</div>
					}
				</div>
			</div>
		}

		<!-- Key Metrics -->
		@if (!string.IsNullOrEmpty(Model.ProblemStatement) || !string.IsNullOrEmpty(Model.Solution) || !string.IsNullOrEmpty(Model.TargetMarket))
		{
			<div class="sidebar-widget">
				<h4 class="widget-title">Opportunity</h4>
				<div class="startup-info-widget">
					@if (!string.IsNullOrEmpty(Model.ProblemStatement))
					{
						<div class="info-row">
							<span class="info-label" style="font-weight: 600;">Problem</span>
							<span class="info-value">@Model.ProblemStatement</span>
						</div>
					}
					@if (!string.IsNullOrEmpty(Model.Solution))
					{
						<div class="info-row">
							<span class="info-label" style="font-weight: 600;">Solution</span>
							<span class="info-value">@Model.Solution</span>
						</div>
					}
					@if (!string.IsNullOrEmpty(Model.TargetMarket))
					{
						<div class="info-row">
							<span class="info-label" style="font-weight: 600;">Market</span>
							<span class="info-value">@Model.TargetMarket</span>
						</div>
					}
				</div>
			</div>
		}

		<!-- Contact CTA -->
		<div class="sidebar-widget">
			<button type="button" class="btn btn-primary" style="width: 100%; font-weight: 600; padding: 0.75rem;" data-bs-toggle="modal" data-bs-target="#contactModal">
				💬 Request Information
			</button>
		</div>
	</div>
</div>

<!-- Contact Modal -->
<div class="modal fade" id="contactModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Contact @Model.CompanyName</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<p>Use the messaging system to request more information about this startup.</p>
				@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Investor"))
				{
					<a href="@Url.Action("SendMessage", "Message", new { startupId = Model.StartupID })" class="btn btn-primary w-100">
						Send Message
					</a>
				}
				else
				{
					<p class="alert alert-info mb-0">
						Please <a href="@Url.Action("Login", "Account")">log in as an investor</a> to contact this startup.
					</p>
				}
			</div>
		</div>
	</div>
</div>

