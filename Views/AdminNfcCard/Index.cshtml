@model IEnumerable<TechNova.Models.NfcCardRequest>

@{
    ViewData["Title"] = "NFC Card Requests";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>NFC Business Card Requests</h2>
            <p class="text-muted">
                Review payments and approve NFC business card requests.
            </p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No NFC business card requests have been submitted yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Request ID</th>
                        <th>User ID</th>
                        <th>User Type</th>
                        <th>Amount</th>
                        <th>Payment</th>
                        <th>Request Status</th>
                        <th>Requested At</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var request in Model)
                    {
                        <tr>
                            <td>@request.NfcCardRequestID</td>

                            <td>@request.UserID</td>

                            <td>
                                <span class="badge bg-secondary">
                                    @request.UserType
                                </span>
                            </td>

                            <td>
                                $@request.Amount.ToString("0.00")
                            </td>

                            <td>
                                @if (request.PaymentStatus == "Paid")
                                {
                                    <span class="badge bg-success">
                                        Paid
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">
                                        @request.PaymentStatus
                                    </span>
                                }
                            </td>

                            <td>
                                @if (request.RequestStatus == "PendingAdminApproval")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Waiting for Approval
                                    </span>
                                }
                                else if (request.RequestStatus == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (request.RequestStatus == "Issued")
                                {
                                    <span class="badge bg-primary">
                                        Issued
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @request.RequestStatus
                                    </span>
                                }
                            </td>

                            <td>
                                @request.RequestedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </td>

                            <td>
                                @if (request.PaymentStatus == "Paid" &&
                                     request.RequestStatus == "PendingAdminApproval")
                                {
                                    <form asp-action="Approve"
                                          method="post">

                                        <input type="hidden"
                                               name="id"
                                               value="@request.NfcCardRequestID" />

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-success btn-sm">
                                            Approve
                                        </button>

                                    </form>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        No action
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>
    }

</div>