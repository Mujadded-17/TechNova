@using TechNova.Models
@{
    ViewData["Title"] = "Admin Dashboard";

    var pendingStartups = ViewBag.PendingStartups as List<Startup> ?? new();
    var pendingInvestors = ViewBag.PendingInvestors as List<Investor> ?? new();
    var queueCount = (int)ViewBag.StartupPending + (int)ViewBag.InvestorPending;
}

<div class="page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Platform overview</h1>
        <p>Verify accounts, monitor activity, and keep the marketplace trustworthy.</p>
    </div>

    <div class="d-flex gap-2">
        <a asp-action="Reports" class="btn btn-outline-secondary btn-sm">View reports</a>
        <a asp-action="Startups" class="btn btn-primary btn-sm">Manage accounts</a>
    </div>
</div>

<partial name="_AdminTabs" />

@if (TempData["AdminMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["AdminMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (queueCount > 0)
{
    <div class="alert alert-info">
        <span class="alert-heading">@queueCount account@(queueCount == 1 ? "" : "s") awaiting review</span>
        New startups and investors stay unverified until an administrator approves them.
    </div>
}

<!-- STAT TILES -->

<div class="row g-3 mb-4">

    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <span class="stat-label">Startups</span>
                <span class="stat-value">@ViewBag.StartupTotal</span>
                <span class="stat-note">@ViewBag.StartupVerified verified &middot; @ViewBag.StartupPending pending</span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <span class="stat-label">Investors</span>
                <span class="stat-value">@ViewBag.InvestorTotal</span>
                <span class="stat-note">@ViewBag.InvestorVerified verified &middot; @ViewBag.InvestorPending pending</span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <span class="stat-label">Investment requests</span>
                <span class="stat-value">@ViewBag.RequestTotal</span>
                <span class="stat-note">@ViewBag.OpportunityTotal opportunit@(ViewBag.OpportunityTotal == 1 ? "y" : "ies") posted</span>
            </div>
        </div>
    </div>

    <div class="col-6 col-lg-3">
        <div class="card h-100">
            <div class="card-body">
                <span class="stat-label">Suspended</span>
                <span class="stat-value">@((int)ViewBag.StartupSuspended + (int)ViewBag.InvestorSuspended)</span>
                <span class="stat-note">@ViewBag.MessageTotal message@(ViewBag.MessageTotal == 1 ? "" : "s") exchanged</span>
            </div>
        </div>
    </div>

</div>

<!-- REVIEW QUEUES -->

<div class="row g-3">

    <div class="col-lg-6">
        <div class="card h-100">

            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Startups awaiting verification</span>
                <a asp-action="Startups" asp-route-status="Pending" class="btn btn-outline-primary btn-sm">See all</a>
            </div>

            <div class="card-body">
                @if (!pendingStartups.Any())
                {
                    <p class="text-muted mb-0">Nothing waiting. All startup accounts have been reviewed.</p>
                }
                else
                {
                    <ul class="review-list">
                        @foreach (var s in pendingStartups)
                        {
                            <li>
                                <div>
                                    <strong>@s.CompanyName</strong>
                                    <span class="d-block text-muted small">@s.Email</span>
                                </div>

                                <form asp-action="SetStartupStatus" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.StartupID" />
                                    <input type="hidden" name="returnStatus" value="Pending" />

                                    <button type="submit" name="status" value="Verified"
                                            class="btn btn-primary btn-sm">Verify</button>

                                    <button type="submit" name="status" value="Rejected"
                                            class="btn btn-outline-secondary btn-sm">Reject</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>

        </div>
    </div>

    <div class="col-lg-6">
        <div class="card h-100">

            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Investors awaiting verification</span>
                <a asp-action="Investors" asp-route-status="Pending" class="btn btn-outline-primary btn-sm">See all</a>
            </div>

            <div class="card-body">
                @if (!pendingInvestors.Any())
                {
                    <p class="text-muted mb-0">Nothing waiting. All investor accounts have been reviewed.</p>
                }
                else
                {
                    <ul class="review-list">
                        @foreach (var i in pendingInvestors)
                        {
                            <li>
                                <div>
                                    <strong>@i.Name</strong>
                                    <span class="d-block text-muted small">@i.Email</span>
                                </div>

                                <form asp-action="SetInvestorStatus" method="post" class="d-flex gap-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@i.InvestorID" />
                                    <input type="hidden" name="returnStatus" value="Pending" />

                                    <button type="submit" name="status" value="Verified"
                                            class="btn btn-primary btn-sm">Verify</button>

                                    <button type="submit" name="status" value="Rejected"
                                            class="btn btn-outline-secondary btn-sm">Reject</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>

        </div>
    </div>

</div>
