<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Tech Nova</title>

    <meta name="description"
          content="Tech Nova connects ambitious startups with investors who are actively looking for the next opportunity." />

    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;450;500;550;600;650;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>

<body class="landing">

    <!-- =========================================================
         ICON SPRITE
         Lucide-style line icons, inlined so the page pulls
         no external icon dependency.
         ========================================================= -->

    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
        <defs>
            <symbol id="i-arrow-right" viewBox="0 0 24 24">
                <path d="M5 12h14M13 6l6 6-6 6" />
            </symbol>
            <symbol id="i-check" viewBox="0 0 24 24">
                <path d="M20 6L9 17l-5-5" />
            </symbol>
            <symbol id="i-search" viewBox="0 0 24 24">
                <circle cx="11" cy="11" r="7" />
                <path d="M21 21l-4.3-4.3" />
            </symbol>
            <symbol id="i-chevron-down" viewBox="0 0 24 24">
                <path d="M6 9l6 6 6-6" />
            </symbol>
            <symbol id="i-menu" viewBox="0 0 24 24">
                <path d="M3 6h18M3 12h18M3 18h18" />
            </symbol>
            <symbol id="i-x" viewBox="0 0 24 24">
                <path d="M18 6L6 18M6 6l12 12" />
            </symbol>
            <symbol id="i-rocket" viewBox="0 0 24 24">
                <path d="M5 13c-1.5 1.5-2 5-2 5s3.5-.5 5-2" />
                <path d="M15 4c3 0 5 2 5 5 0 4-4 8-7 10l-4-4C11 12 15 8 19 8" />
                <circle cx="14.5" cy="9.5" r="1.5" />
            </symbol>
            <symbol id="i-trending" viewBox="0 0 24 24">
                <path d="M3 17l6-6 4 4 7-7" />
                <path d="M14 8h6v6" />
            </symbol>
            <symbol id="i-bookmark" viewBox="0 0 24 24">
                <path d="M6 4h12v17l-6-4-6 4z" />
            </symbol>
            <symbol id="i-message" viewBox="0 0 24 24">
                <path d="M21 12a8 8 0 0 1-8 8H7l-4 3v-9a8 8 0 0 1 8-8h2a8 8 0 0 1 8 6z" />
            </symbol>
            <symbol id="i-bell" viewBox="0 0 24 24">
                <path d="M18 8a6 6 0 1 0-12 0c0 6-3 7-3 7h18s-3-1-3-7" />
                <path d="M13.7 21a2 2 0 0 1-3.4 0" />
            </symbol>
            <symbol id="i-target" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <circle cx="12" cy="12" r="5" />
                <circle cx="12" cy="12" r="1.4" />
            </symbol>
            <symbol id="i-layers" viewBox="0 0 24 24">
                <path d="M12 3l9 5-9 5-9-5z" />
                <path d="M3 13l9 5 9-5" />
            </symbol>
            <symbol id="i-wallet" viewBox="0 0 24 24">
                <path d="M3 7a2 2 0 0 1 2-2h13v4" />
                <path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-6a2 2 0 0 0-2-2H5" />
                <circle cx="17" cy="14" r="1.2" />
            </symbol>
            <symbol id="i-activity" viewBox="0 0 24 24">
                <path d="M3 12h4l3-8 4 16 3-8h4" />
            </symbol>
            <symbol id="i-graduation" viewBox="0 0 24 24">
                <path d="M12 4L2 9l10 5 10-5z" />
                <path d="M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5" />
            </symbol>
            <symbol id="i-zap" viewBox="0 0 24 24">
                <path d="M13 2L4 14h7l-1 8 9-12h-7z" />
            </symbol>
            <symbol id="i-globe" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path d="M3 12h18M12 3c2.5 3 2.5 15 0 18M12 3c-2.5 3-2.5 15 0 18" />
            </symbol>
            <symbol id="i-handshake" viewBox="0 0 24 24">
                <path d="M11 17l2 2 3-3 3 3 3-3-6-7-3 1-3-1-6 7 3 3z" />
            </symbol>
            <symbol id="i-briefcase" viewBox="0 0 24 24">
                <rect x="2" y="7" width="20" height="14" rx="2" />
                <path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2M2 13h20" />
            </symbol>
        </defs>
    </svg>


    <!-- =========================================================
         NAVBAR
         ========================================================= -->

    <header class="nav" id="siteNav">
        <div class="shell nav__inner">

            <a class="nav__brand" asp-controller="Home" asp-action="Index">Tech Nova</a>

            <nav class="nav__links" aria-label="Primary">
                <a href="#discover">Discover Startups</a>
                <a href="#for-startups">For Startups</a>
                <a href="#for-investors">For Investors</a>
                <a href="#how-it-works">How It Works</a>
                <a href="#about">About</a>
            </nav>

            <div class="nav__actions">

                <a class="nav__login" asp-controller="Account" asp-action="Login">Log In</a>

                <div class="nav__cta-wrap" id="navCtaWrap">

                    <button type="button"
                            class="btn btn--outline-light btn--sm"
                            id="navCtaBtn"
                            aria-haspopup="true"
                            aria-expanded="false">
                        Get Started
                        <svg class="ico ico--sm"><use href="#i-chevron-down" /></svg>
                    </button>

                    <div class="nav__menu" role="menu" aria-labelledby="navCtaBtn">

                        <a asp-controller="Account" asp-action="RegisterStartup" role="menuitem">
                            <strong>Get started as a Startup</strong>
                            <span>Showcase your business and raise funding.</span>
                        </a>

                        <a asp-controller="Account" asp-action="RegisterInvestor" role="menuitem">
                            <strong>Join as an Investor</strong>
                            <span>Discover opportunities that match your criteria.</span>
                        </a>

                    </div>

                </div>

                <button type="button"
                        class="nav__burger"
                        id="navBurger"
                        aria-label="Open menu"
                        aria-expanded="false"
                        aria-controls="navDrawer">
                    <svg class="ico"><use href="#i-menu" /></svg>
                </button>

            </div>

        </div>
    </header>

    <div class="nav__drawer" id="navDrawer">
        <a href="#discover">Discover Startups</a>
        <a href="#for-startups">For Startups</a>
        <a href="#for-investors">For Investors</a>
        <a href="#how-it-works">How It Works</a>
        <a href="#about">About</a>
        <a asp-controller="Account" asp-action="Login">Log In</a>

        <a class="btn btn--brand" asp-controller="Account" asp-action="RegisterStartup">
            Get Started
            <svg class="ico ico--sm btn__arrow"><use href="#i-arrow-right" /></svg>
        </a>
    </div>


    <main>
        @RenderBody()
    </main>


    <!-- =========================================================
         FOOTER
         ========================================================= -->

    <footer class="footer">
        <div class="shell">

            <div class="footer__grid">

                <div>
                    <a class="footer__brand" asp-controller="Home" asp-action="Index">Tech Nova</a>

                    <p class="footer__tagline">
                        Where startups meet opportunity.
                    </p>
                </div>

                <div>
                    <h4>Platform</h4>
                    <ul>
                        <li><a href="#discover">Discover Startups</a></li>
                        <li><a href="#how-it-works">How It Works</a></li>
                        <li><a href="#for-startups">For Startups</a></li>
                        <li><a href="#for-investors">For Investors</a></li>
                    </ul>
                </div>

                <div>
                    <h4>Company</h4>
                    <ul>
                        <li><a href="#about">About</a></li>
                        <li><a href="#contact">Contact</a></li>
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy Policy</a></li>
                        <li><a href="#terms">Terms of Service</a></li>
                    </ul>
                </div>

                <div>
                    <h4>Resources</h4>
                    <ul>
                        <li><a href="#startup-guide">Startup Guide</a></li>
                        <li><a href="#investor-guide">Investor Guide</a></li>
                        <li><a href="#faqs">FAQs</a></li>
                    </ul>
                </div>

            </div>

            <div class="footer__bottom">
                <span>&copy; 2026 Tech Nova. All rights reserved.</span>
                <span>Where startups meet opportunity.</span>
            </div>

        </div>
    </footer>


    <script src="~/js/velaris.js" asp-append-version="true"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
