@model ErrorViewModel
@{
    ViewData["Title"] = Model.Heading;
}

<section class="error-page">
    <div class="error-card">
        @if (Model.StatusCode.HasValue)
        {
            <p class="error-code">@Model.StatusCode</p>
        }

        <h1 class="error-heading">@Model.Heading</h1>
        <p class="error-detail">@Model.Detail</p>

        <div class="error-actions">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
            <a class="btn btn-outline-secondary" asp-controller="Explore" asp-action="Startups">Explore startups</a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="error-ref">
                Reference <code>@Model.RequestId</code>
            </p>
        }
    </div>
</section>

<style>
    .error-page {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        padding: 48px var(--gutter);
    }

    .error-card {
        width: 100%;
        max-width: 560px;
        text-align: center;
        background: var(--paper);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        padding: 48px 40px;
    }

    .error-code {
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--brand);
        margin: 0 0 12px;
    }

    .error-heading {
        font-size: clamp(24px, 4vw, 32px);
        font-weight: 650;
        letter-spacing: var(--tracking-head);
        color: var(--ink);
        margin: 0 0 12px;
    }

    .error-detail {
        color: var(--muted);
        line-height: 1.6;
        margin: 0 0 28px;
    }

    .error-actions {
        display: flex;
        gap: 12px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .error-ref {
        margin: 28px 0 0;
        padding-top: 20px;
        border-top: 1px solid var(--line-soft);
        font-size: 12px;
        color: var(--muted-soft);
    }

    .error-ref code {
        color: var(--muted);
        word-break: break-all;
    }
</style>
