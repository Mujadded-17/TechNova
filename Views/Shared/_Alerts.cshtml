@*
    One place for post-redirect feedback. Controllers set TempData["Success"]
    or TempData["Error"] and redirect; whichever page renders next shows it.
    Pages with their own keys (AdminMessage, BillingMessage, DeckMessage…)
    keep rendering those themselves.
*@
@if (TempData["Success"] is string success && !string.IsNullOrWhiteSpace(success))
{
    <div class="alert alert-success alert-dismissible fade show" role="status">
        @success
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
    </div>
}
@if (TempData["Error"] is string error && !string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Dismiss"></button>
    </div>
}
