@using System.Security.Claims
@{
    var displayName = User.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var initials = string.IsNullOrWhiteSpace(displayName)
        ? "?"
        : string.Concat(displayName
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(w => w[0]));
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Tech Nova</title>
    <script type="importmap"></script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;450;500;550;600;650;700&display=swap"
          rel="stylesheet" />

    @* Order matters: Bootstrap first, then tokens, then the theme
       layer that restyles Bootstrap with those tokens. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TechNova.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-light app-nav">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Tech Nova</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.IsInRole("Startup"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Startup" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Startup" asp-action="Opportunities">Opportunities</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Startup" asp-action="InvestmentRequests">Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="PitchDeck" asp-action="Index">Pitch Decks</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Explore" asp-action="Investors">Investors</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Message" asp-action="Index">
                                    Messages @await Component.InvokeAsync("UnreadCount")
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Investor"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Investor" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Investor" asp-action="Discover">Discover</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Explore" asp-action="Startups">Directory</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Investor" asp-action="Favorites">Saved</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Investor" asp-action="MyRequests">My Requests</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Message" asp-action="Index">
                                    Messages @await Component.InvokeAsync("UnreadCount")
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Billing" asp-action="Plans">Plans</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Explore" asp-action="Startups">Startups</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle user-chip" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <span class="user-avatar">@initials</span>
                                    <strong>@displayName</strong>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    @if (User.IsInRole("Startup"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Startup" asp-action="Dashboard">Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Startup" asp-action="EditProfile">Edit Profile</a></li>
                                    }
                                    @if (User.IsInRole("Investor"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Investor" asp-action="Dashboard">Dashboard</a></li>
                                        <li><a class="dropdown-item" asp-controller="Investor" asp-action="Discover">Discover</a></li>
                                        <li><a class="dropdown-item" asp-controller="Investor" asp-action="EditProfile">Edit Profile</a></li>
                                        <li><a class="dropdown-item" asp-controller="Billing" asp-action="Manage">Subscription</a></li>
                                    }
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Admin Dashboard</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="Logout" style="display: inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item" style="border: none; background: none; cursor: pointer; text-align: left; width: 100%;">
                                                Logout
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Log In</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="app-main">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer">
        <div class="container d-flex flex-wrap justify-content-between gap-2">
            <span>&copy; 2026 Tech Nova</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
